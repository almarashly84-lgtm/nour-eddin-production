{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nour-eddin-production",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/media/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nour-db",
      "database_id": "4556ee9f-97dd-4689-9ec0-1a6fff5d1f72"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "nour-media" }
  ],
  "vars": {
    "SHOP_TIMEZONE": "Europe/Vienna"
  }
  // Secrets (not here): ADMIN_INITIAL_PASSWORD and IP_SALT — set them in Cloudflare → Settings → Variables and Secrets
}
